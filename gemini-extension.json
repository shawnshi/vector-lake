{
  "name": "vector-lake",
  "version": "11.14.0",
  "description": "Local file-first knowledge compiler with auditable Markdown, structured memory, and graph operations.",
  "contextFileName": "CONTEXT.md",
  "mcpServers": {
    "vector-lake-mcp": {
      "command": "python",
      "args": [
        "-m",
        "vector_lake.mcp_server"
      ],
      "cwd": "${extensionPath}",
      "env": {
        "PYTHONPATH": "${extensionPath}",
        "VECTOR_LAKE_META_DIR": "~/.gemini/MEMORY/wiki/.meta",
        "OPENBLAS_NUM_THREADS": "1",
        "OMP_NUM_THREADS": "1"
      }
    }
  },
  "runtime": {
    "recommended_cwd": "plugins/vector-lake/",
    "python_version": ">=3.10",
    "setup": "pip install -r requirements.txt"
  },
  "excludeTools": [
    "run_shell_command(rm -rf *)",
    "run_shell_command(del /s /q *)"
  ]
}
