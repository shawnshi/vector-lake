{
  "name": "vector-lake",
  "version": "11.20.0",
  "description": "Local file-first knowledge compiler for healthcare digitalization research, with auditable Markdown, structured memory, and graph governance.",
  "contextFileName": "CONTEXT.md",
  "mcpServers": {
    "vector-lake-mcp": {
      "command": "python",
      "args": [
        "${extensionPath}/scripts/vector_lake_mcp.py",
        "--profile",
        "default",
        "--surface",
        "full"
      ],
      "cwd": "${extensionPath}",
      "env": {
        "VECTOR_LAKE_PAYLOAD_ROOT": "~/.gemini/tmp",
        "VECTOR_LAKE_AGENT_SANDBOX_ROOTS": "~/.gemini"
      }
    }
  },
  "runtime": {
    "launcher": "scripts/vector_lake_mcp.py",
    "profile": "default",
    "python_version": ">=3.11",
    "setup": "pip install -r requirements.txt"
  },
  "excludeTools": [
    "run_shell_command(rm -rf *)",
    "run_shell_command(del /s /q *)"
  ]
}
