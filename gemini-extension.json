{
  "name": "vector-lake",
  "version": "8.3.0",
  "description": "LLM-Wiki engine for long-term memory retrieval and semantic consolidation via pure Markdown knowledge graph.",
  "contextFileName": "CONTEXT.md",
  "mcpServers": {
    "vector-lake-mcp": {
      "command": "python",
      "args": [
        "-m",
        "vector_lake.mcp_server"
      ],
      "cwd": "C:/Users/shich/.gemini/config/plugins/vector-lake",
      "env": {
        "PYTHONPATH": "C:/Users/shich/.gemini/config/plugins/vector-lake"
      }
    }
  },
  "runtime": {
    "recommended_cwd": "plugins/vector-lake/",
    "python_version": ">=3.10",
    "setup": "pip install -r requirements.txt"
  },
  "excludeTools": [
    "run_shell_command(rm -rf *)",
    "run_shell_command(del /s /q *)"
  ]
}