{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vector-lake.local/contracts/cbss/critical-decision-registry.schema.json",
  "title": "CBSS CriticalDecisionRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "decisions"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "title",
          "owner",
          "status",
          "risk_weight",
          "evidence_requirements",
          "verification"
        ],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "status": {"enum": ["draft", "active", "retired"]},
          "risk_weight": {"type": "number", "minimum": 1, "maximum": 100},
          "evidence_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "policy_refs": {"type": "array", "items": {"type": "string"}},
          "claim_refs": {
            "description": "Canonical Vector Lake claim identifiers in this decision scope.",
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "verification": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
