{
  "mcpServers": {
    "vector-lake-mcp": {
      "command": "python",
      "args": [
        "-m",
        "vector_lake.mcp_server"
      ],
      "cwd": ".",
      "env": {
        "PYTHONPATH": ".",
        "VECTOR_LAKE_MEMORY_DIR": "~/MEMORY",
        "VECTOR_LAKE_META_DIR": "~/MEMORY/wiki/.meta",
        "VECTOR_LAKE_OPERATIONAL_MEMORY_FTS": "1",
        "VECTOR_LAKE_DURABILITY_PROFILE": "full",
        "OPENBLAS_NUM_THREADS": "1",
        "OMP_NUM_THREADS": "1"
      }
    }
  }
}
