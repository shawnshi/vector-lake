{
  "mcpServers": {
    "vector-lake-mcp": {
      "command": "python",
      "args": [
        "-m",
        "vector_lake.mcp_server"
      ],
      "cwd": ".",
      "env": {
        "PYTHONPATH": ".",
        "VECTOR_LAKE_META_DIR": "~/.gemini/MEMORY/wiki/.meta",
        "OPENBLAS_NUM_THREADS": "1",
        "OMP_NUM_THREADS": "1"
      }
    }
  }
}
